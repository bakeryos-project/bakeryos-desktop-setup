[org/gnome/shell]
enabled-extensions=['bakeryos@bakeryos.smtdfc.net','dash-to-panel@jderose9.github.com', 'tilingshell@ferrarodomenico.com', 'gtk4-ding@smedius.gitlab.com', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'arcmenu@arcmenu.com', 'clipboard-history@alexsaveau.dev', 'Vitals@CoreCoding.com', 'status-tray@keithvassallo.com']

[org/gnome/shell/keybindings]
focus-active-notification=@as []
toggle-message-tray=['<Super>n']


[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'

[org/gnome/desktop/interface]
accent-color='orange'
clock-format='24h'
clock-show-date=true
clock-show-seconds=false
clock-show-weekday=false
color-scheme='prefer-dark'
cursor-theme='Bibata-Material-Slate-Light'
enable-animations=true
enable-hot-corners=false
font-antialiasing='rgba'
font-name='Ubuntu 11'
gtk-theme='adw-gtk3'
icon-theme='Papirus'
monospace-font-name='JetBrainsMono Nerd Font Light 11'
show-battery-percentage=false
toolkit-accessibility=false

[org/gnome/desktop/calendar]
show-weekdate=false

[org/gnome/desktop/datetime]
automatic-timezone=false
